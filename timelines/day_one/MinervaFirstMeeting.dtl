	set {Timeline_Managment.MinervaInt1_1_MemCodesLearnt} += 1.0
	Player (Default): "Where are you from?"
	Minerva (Sad): "Not really sure it matters anymore, but I'm from {Minerva.from}. You'd think I'd be used to this weather because of that, but it actually doesn't really get this bad there."
	[signal arg="1001"]
	set {Timeline_Managment.MinervaInt1_1WhereFrom} = 1.0
